// Cloudflare Workers para nogalera.capitaltorreon.com
// Sitio estático (public/) servido por el Worker, más (worker/index.js):
//   /api/render-ia   renders fotorrealistas con OpenAI (secretos OPENAI_API_KEY y RENDER_CLAVE)
//   /api/prospecto   guarda los datos de los clientes de /inicio/ en un Durable Object con SQLite (no hay que crear nada en Cloudflare)
//   /api/prospectos  descarga de los prospectos con la clave ADMIN_CLAVE (?clave=…&formato=csv)
// Secretos: npx wrangler secret put …, o Settings → Variables and Secrets. public/_headers pone las cabeceras de los archivos estáticos.
{
  // Debe coincidir con el nombre del Worker en Cloudflare (Workers & Pages → nogalera).
  "name": "nogalera",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // La base de datos de prospectos: un Durable Object con SQLite (incluido en el plan gratuito).
  "durable_objects": {
    "bindings": [{ "name": "PROSPECTOS", "class_name": "Prospectos" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Prospectos"] }],
  // Variables de texto (no secretas). AVISO_CORREO (a quién avisar de cada prospecto) sí es secreto.
  "vars": { "AVISO_DESDE": "La Nogalera <nogalera@capitaltorreon.com>" },
  // La llave de Resend ya vive en el Secrets Store de la cuenta (nombre RESEND_API_KEY, scope workers): se conecta aquí con el id de la bóveda,
  // que sale de `npx wrangler secrets-store store list`. El código acepta las dos formas (binding del Store o `npx wrangler secret put RESEND_API_KEY`).
  // "secrets_store_secrets": [
  //   { "binding": "RESEND_API_KEY", "store_id": "<id de la bóveda>", "secret_name": "RESEND_API_KEY" }
  // ],
  // Al publicar, Cloudflare conecta el subdominio y crea el registro DNS y el certificado.
  // Requiere que la zona capitaltorreon.com esté en la misma cuenta de Cloudflare.
  "routes": [
    { "pattern": "nogalera.capitaltorreon.com", "custom_domain": true }
  ]
}
